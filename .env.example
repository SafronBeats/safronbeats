# ---------- store identity ----------
STORE_NAME=SAFRON BEATS
PRODUCER_NAME=SAFRON BEATS
STORE_TAGLINE=Beats that carry a record.
STORE_CURRENCY=USD
CONTACT_EMAIL=safronbeats@gmail.com
INSTAGRAM_URL=
YOUTUBE_URL=

# ---------- admin ----------
# Change this before going live.
ADMIN_PASSWORD=safron

# ---------- payments ----------
# PayPal: create an app at https://developer.paypal.com/dashboard/applications
# Use sandbox keys first, then switch PAYPAL_MODE=live with live keys.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Stripe (optional, cards): https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ---------- server ----------
PORT=3000
NODE_ENV=development
# Public base URL, used for PayPal/Stripe return links. Set this in production:
# STORE_URL=https://safronbeats.com
STORE_URL=

# Optional: point storage at a mounted disk (Docker/Render volumes).
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads
